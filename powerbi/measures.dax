// ===== Paris Vélib' Operations Intelligence: DAX measures =====
// Home > Enter data > name the table "Measures" > Load. Then select it and use
// "New measure" for each block below (paste the whole block, including the name).

Stations = DISTINCTCOUNT ( mart_station_hourly[station_id] )

Days Observed = DISTINCTCOUNT ( mart_station_hourly[local_date] )

% Time Empty =
DIVIDE (
    SUMX ( mart_station_hourly, mart_station_hourly[share_empty] * mart_station_hourly[n_snapshots] ),
    SUM ( mart_station_hourly[n_snapshots] )
)

% Time Full =
DIVIDE (
    SUMX ( mart_station_hourly, mart_station_hourly[share_full] * mart_station_hourly[n_snapshots] ),
    SUM ( mart_station_hourly[n_snapshots] )
)

// Robust to partial days: share of time x stations x 24 h
Empty Station Hours per Day = [% Time Empty] * [Stations] * 24

Full Station Hours per Day = [% Time Full] * [Stations] * 24

Empty Station Hours = SUM ( mart_station_hourly[empty_hours] )

Avg Fill Ratio =
DIVIDE (
    SUMX ( mart_station_hourly, mart_station_hourly[avg_fill_ratio] * mart_station_hourly[n_snapshots] ),
    SUM ( mart_station_hourly[n_snapshots] )
)

Avg Bikes = AVERAGE ( mart_station_hourly[avg_bikes] )

// "20 stations cause X% of all empty-station hours"
Top 20 Share of Empty Hours =
VAR Top20 =
    TOPN ( 20, ALL ( dim_station[station_id] ), [Empty Station Hours], DESC )
RETURN
    DIVIDE (
        CALCULATE ( [Empty Station Hours], Top20 ),
        CALCULATE ( [Empty Station Hours], ALL ( dim_station ) )
    )

Activity per Station-Hour =
DIVIDE ( SUM ( mart_station_hourly[activity] ), COUNTROWS ( mart_station_hourly ) )

Rain Effect on Activity =
VAR Wet = CALCULATE ( [Activity per Station-Hour], mart_station_hourly[precip_mm] > 0 )
VAR Dry = CALCULATE ( [Activity per Station-Hour], mart_station_hourly[precip_mm] = 0 )
RETURN DIVIDE ( Wet, Dry ) - 1

Collection Coverage = AVERAGE ( mart_data_quality[coverage] )

Data Through = "Data " & FORMAT ( MIN ( mart_station_hourly[local_date] ), "d mmm" ) & " – " & FORMAT ( MAX ( mart_station_hourly[local_date] ), "d mmm yyyy" )
